# Copy this file to `.env` and fill in your Reddit "script" app credentials.
# Create one for free at https://www.reddit.com/prefs/apps (choose type "script").
# Only the client id + secret are needed for read-only search.

REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=myntra-voc-collector/0.1 by u/your_reddit_username

# Stage 2 (extract.py) — pick ONE cloud backend (or use --ollama / --mock):
# Claude API key from https://console.anthropic.com/  (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-...
# Groq API key from https://console.groq.com/keys     (starts with gsk_)
GROQ_API_KEY=gsk_...
